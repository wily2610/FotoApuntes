{
  "expo": {
    "name": "FotoApuntes",
    "slug": "fotoapuntes",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fotoapuntes",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.fcfm.fotoapuntes",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "FotoApuntes necesita la cámara para fotografiar tus apuntes.",
          "photosPermission": "FotoApuntes necesita tu galería para elegir apuntes."
        }
      ],
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "46284508-7768-40a9-94c9-f2397dd4b005"
      }
    }
  }
}
